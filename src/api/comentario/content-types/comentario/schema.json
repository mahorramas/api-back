{
  "kind": "collectionType",
  "collectionName": "comentarios",
  "info": {
    "singularName": "comentario",
    "pluralName": "comentarios",
    "displayName": "Comentario"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "autor": {
      "type": "string"
    },
    "puntuacion": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "titulo": {
      "type": "string"
    },
    "comentario": {
      "type": "text"
    },
    "ubicacion": {
      "type": "string"
    },
    "compra_verificada": {
      "type": "boolean",
      "default": false
    },
    "usuario": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "mueble": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::mueble.mueble",
      "inversedBy": "comentarios"
    }
  }
}
